---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { site } from '../content/site';
import { LOCALES, getDictionary, localePath, withBase, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

// Domen (SITE_URL) berilgandagina to'liq havolalar chiqariladi.
const absoluteUrl = (path: string) => (Astro.site ? new URL(path, Astro.site).href : null);
const canonical = absoluteUrl(localePath(locale));

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: t.meta.description,
  ...(canonical ? { url: canonical } : {}),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      LOCALES.map((code) => {
        const href = absoluteUrl(localePath(code));
        return href && <link rel="alternate" hreflang={code} href={href} />;
      })
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={locale} />
    {canonical && <meta property="og:url" content={canonical} />}
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <slot />
  </body>
</html>
