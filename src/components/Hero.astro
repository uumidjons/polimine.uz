---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="hero__eyebrow">{t.hero.eyebrow}</p>
    <h1 class="hero__title" id="hero-title">{t.hero.title}</h1>
    <p class="hero__lead">{t.hero.lead}</p>
    <div class="hero__actions">
      <a class="btn" href="#contact">{t.hero.cta}</a>
      <a class="btn btn--ghost" href="#products">{t.hero.secondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 9rem);
  }

  .hero__eyebrow {
    margin-bottom: 1.25rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__title {
    max-width: 18ch;
    font-size: clamp(2.25rem, 6.5vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 56rem) {
    .hero {
      text-align: center;
    }

    .hero__title,
    .hero__lead {
      margin-inline: auto;
    }

    .hero__actions {
      justify-content: center;
    }
  }
</style>
